                "slug": "reference/attributes/subcommand",
                "parameters": [
                    {
                        "name": "name",
                        "type": "BackedEnum|string",
                        "default": null,
                        "required": true,
                        "summary": ""
                    },
                    {
                        "name": "description",
                        "type": "string",
                        "default": null,
                        "required": true,
