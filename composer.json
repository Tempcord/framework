{
    "name": "tempcord/framework",
    "description": "A modern, elegant PHP framework for building Discord bots with ease",
    "type": "library",
    "license": "MIT",
    "homepage": "https://tempcord.dev",
    "keywords": [
        "discord",
        "discord-bot",
        "bot",
        "framework",
        "tempest",
        "php"
    ],
    "authors": [
        {
            "name": "CyberWolf.Studio",
            "email": "hello@cyberwolf.studio",
            "homepage": "https://cyberwolf.studio",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Tempcord/framework/issues",
        "source": "https://github.com/Tempcord/framework",
        "docs": "https://tempcord.dev",
        "chat": "https://discord.gg/tempcord"
    },
    "require": {
        "php": "^8.5",
        "cyberwolf-studio/discord-php": "dev-fix/single-object-mapping-and-member-chunks",
        "tempest/console": "^3.18",
        "tempest/core": "^3.18",
        "tempest/event-bus": "^3.18",
        "tempest/log": "^3.18"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "suggest": {
        "tempest/intl": "Enables name and description translations for commands via #[Command(translationKey: ...)]. Requires ext-intl."
    },
    "autoload": {
        "psr-4": {
            "Tempcord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tempcord\\Tests\\": "tests/",
            "Tempcord\\Tools\\": "tools/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs-fix": "php-cs-fixer fix",
        "docs": "php tools/generate-docs.php"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/CyberWolf-Studio/discord-php"
        }
    ]
}
